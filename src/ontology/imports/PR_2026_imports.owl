        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000001673"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lysophospholipid (S1P) receptor that is a translation product of the human S1PR4 gene or a 1:1 ortholog thereof. This receptor is specifically expressed in fetal and adult lymphoid and hematopoietic tissue as well as in lung.</obo:IAO_0000115>
