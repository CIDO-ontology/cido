        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000022007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000022007">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebrate-like neuraminidase</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is a glycohydrolytic enzyme, which removes sialic acid residues from a variety of sialoglycoconjugates. Sialidases have highly conserved active site residues, the F/YRIV/P motif in the N-terminal part and the Asp boxes (consensus S/TXD(x)GxTW/F present as three to five repeat in the protein) similar to their viral and bacterial counter parts.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000022007</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sialidase</oboInOwl:hasBroadSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


