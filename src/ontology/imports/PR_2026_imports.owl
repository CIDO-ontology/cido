    <!-- http://purl.obolibrary.org/obo/PR_000001777 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001777">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IKK-related kinase</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that has a core domain composition consisting of one copy of the Protein kinase domain (Pfam:PF00069) at the N terminus, and with average length of about 720 residues. Members of this class have essential roles in innate immunity through signal-induced activation of IRF3 and IRF7.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF038348</oboInOwl:hasDbXref>
