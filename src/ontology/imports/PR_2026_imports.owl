    <!-- http://purl.obolibrary.org/obo/PR_000001103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001103">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-hydroxytryptamine receptor 7</rdfs:label>
