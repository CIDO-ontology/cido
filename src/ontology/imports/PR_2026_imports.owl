        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is a gene product level of the MAP2K3 or the MAP2K6 gene. Members of this class activate phosphorylation of a threonine and a tyrosine residue in MAP kinase p38 exclusively.</obo:IAO_0000115>
