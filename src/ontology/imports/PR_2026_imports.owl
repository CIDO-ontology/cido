    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001565">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">H4 histamine receptor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000049994"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A histamine receptor that is a translation product of the human HRH4 gene or a 1:1 ortholog thereof. The preferred ligand is histamine. This receptor is expressed primarily in the bone marrow and eosinophils but also in a wide variety of peripheral tissues, including the heart, kidney, liver, lung, pancreas, skeletal muscle, prostate, small intestine, spleen, testis, colon, fetal liver and lymph node.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AXOR35</oboInOwl:hasExactSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=gene.</rdfs:comment>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G-protein coupled receptor 105</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPCR105</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPRv53</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">H4R</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HH4R</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HRH4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPHARobj:265</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001565</oboInOwl:id>
