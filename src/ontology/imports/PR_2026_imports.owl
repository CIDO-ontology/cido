    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001030">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">erm protein</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that contain 3 domains, an N-terminal globular domain, an extended alpha-helical domain, and a charged C-terminal domain. Ezrin, radixin and merlin also contain a polyproline region between the helical and C-terminal domains. The N-terminal domain is highly conserved, and is also found in merlin, band 4.1 proteins and members of the band 4.1 superfamily. ERM proteins are involved in crosslinking actin filaments with plasma membranes.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF002305</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001030</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001041">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Na(+)/H(+) exchange regulatory cofactor NHE-RF1</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000001043"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Na(+)/H(+) exchange regulatory cofactor with ERM-binding domain that is a translation product of the human NHERF1 gene or a 1:1 ortholog thereof. It contains two copies of the PDZ domain at the N terminus and an EBP50 domain at the C-terminus. The latter allows interaction with FERM domains, resulting in the activation of ERM proteins (PR:000001030), with subsequent cytoskeletal modulation and cellular growth control.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=gene.</rdfs:comment>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EBP50</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NHERF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NHERF-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NHERF1</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001041</oboInOwl:id>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SLC9A3R1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ezrin-radixin-moesin-binding phosphoprotein 50</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regulatory cofactor of Na(+)/H(+) exchanger</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sodium-hydrogen exchanger regulatory factor 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solute carrier family 9 isoform A3 regulatory factor 1</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001043">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Na(+)/H(+) exchange regulatory cofactor with ERM-binding domain</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that consists of two copies of the PDZ domain (Pfam:PF00595) and a copy of the EBP50, C-terminal (Pfam:PF09007) domain.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NHERF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF037866</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001043</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001044">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cystic fibrosis transmembrane conductance regulator</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000044678"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chloride channel protein that is a translation product of the human CFTR gene or a 1:1 ortholog thereof. Involved in the transport of chloride ions. The characteristic domain composition of the functional isoform consists of two modules of a membrane-spanning domain (ABC transporter transmembrane region) followed by a nucleotide-binding domain (ABC transporter domains), separated by an intracellular regulatory domain (R-domain). It also contains a C-terminal PDZ-binding region. The R-domain is an inhibitory domain of CFTR, and phosphorylation of the R-domain removes this inhibition, allowing activation of chloride flux.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABCC7</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ATP-binding cassette sub-family C member 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ATP-binding cassette transporter sub-family C member 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFTR</oboInOwl:hasExactSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=gene. Note: The open conformation of the CFTR channel is stabilized via interaction of its N-terminal region with other proteins, most notably filamin. [PRO:DAN, PMID:29779042]</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPHARobj:707</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF002777</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001044</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cAMP-dependent chloride channel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">channel conductance-controlling ATPase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001094">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rhodopsin-like G-protein coupled receptor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000030035"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A G-protein coupled receptor that contains the 7 transmembrane receptor (rhodopsin family) domain (Pfam:PF00001), which includes 7 transmembrane helices (TMI-TM7) with 3 intracellular loops (IL1-IL3) and 3 extracellular loops (EL1-EL3) between the helices. The amino-terminal region is extracellular and the carboxyl-terminal region is intracellular. Rhodopsin-like G-protein coupled receptors (GPCRs) are unique among the several classes of GPCRs in that most have a very short amino-terminal segment and several characteristic sequence motifs, particularly NSxxNPxxY in TM7 and D/E-R-Y/F between TM3 and loop IL2. Most bind their ligands within a cavity between the TM regions.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family. Classification based on GRAFS system. [PMID:12761335]</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPHAR:GPCRListForward?class=A</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF800006</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001094</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class 1 G-protein coupled receptor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class A G-protein coupled receptor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fam:rhodopsin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001095">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">secretin-like G-protein coupled receptor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000030035"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A G-protein coupled receptor that contains the 7 transmembrane receptor (secretin family) domain (Pfam:PF00002) and has an amino-terminal segment of about 50-80 residues that contains conserved disulfide bonds and participates in ligand binding.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family. Classification based on GRAFS system. [PMID:12761335]</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPHAR:GPCRListForward?class=B</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001095</oboInOwl:id>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class 2 G-protein coupled receptor</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class B G-protein coupled receptor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fam:secretin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subfamily B1 G-protein coupled receptor</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001096">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toll-like receptor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that has a core domain composition consisting of a signal peptide, an extracellular domain with multiple Leucine rich repeat (Pfam:PF13855) domain (LRR), a cysteine-rich region, a single-pass transmembrane domain and a C-terminal cytoplasmic tail containing a TIR domain (Pfam:PF01582).</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF800008</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001096</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fam:TLR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001098">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-hydroxytryptamine receptor 1</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000044625"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 5-hydroxytryptamine receptor that is a translation product of the human HTR1A, HTR1B, HTR1D, HTR1E or HTR1F genes, 1:1 orthologs thereof, or a semi-ortholog thereof. The preferred ligand is 5-hydroxytryptamine (serotonin).</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF005474</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001098</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001099">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-hydroxytryptamine receptor 2</rdfs:label>
