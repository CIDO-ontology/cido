    <!-- http://purl.obolibrary.org/obo/PR_000044455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000044455">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lentivirus-type gag-pol polyprotein</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000003507"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chimeric protein that is a translation product of a ribosomal frameshift between the human immunodeficiency virus type 1 group M subtype B (isolate HXB2) gag and pol genes, or 1:1 orthologs thereof.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=gene. Note: Includes proteins from HIV and other primate lentiviruses, such as SIV. Produced by ribosomal frameshifting between the gag and pol genes.</rdfs:comment>
