        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A proto-oncogene SRC-like tyrosine-protein kinase that is a translation product of the human SRC gene or a 1:1 ortholog thereof.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=gene.</rdfs:comment>
