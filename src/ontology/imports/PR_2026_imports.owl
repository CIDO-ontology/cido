    <!-- http://purl.obolibrary.org/obo/PR_000029187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000029187">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ribosomal protein S6 kinase alpha</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that has a core domain composition consisting of a Protein kinase domain (Pfam:PF00069) followed by a Protein kinase C terminal domain (Pfam:PF00433) and another copy of the a Protein kinase domain (Pfam:PF00069). Prototype members of this class act downstream of ERK1/2 signaling pahtway. There are two functional kinase domains that are activated in a sequential manner by a series of phosphorylations.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPK-activated protein kinase-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAPKAP-K1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF000606</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000029187</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p90 ribosomal S6 kinase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p90RSK</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ribosomal protein S6 kinase II</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000029188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000029188">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cAMP-dependent protein kinase catalytic subunit</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that has a core domain composition consisting of a Protein kinase domain (Pfam:PF00069). Prototype members of this class are the catalytic subunit of PKA. Protein Kinase A (PKA) catalyzes the transfer of the terminal phosphate of ATP to Thr or Ser residues in a variety of protein substrates. The enzyme is composed of two subunit types: a catalytic subunit and a regulatory subunit. In the absence of cAMP, the two subunits are bound to each other and no catalysis can take place. In the presence of cAMP, the regulatory subunit binds cAMP, thus releasing the catalytic subunit.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF501114</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PKA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PKA C</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000029188</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cAMP-dependent protein kinase catalytic subunit alpha/beta/gamma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


