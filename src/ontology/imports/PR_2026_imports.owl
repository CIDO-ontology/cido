    <!-- http://purl.obolibrary.org/obo/PR_000029090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000029090">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">atypical kinase COQ8B, mitochondrial</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is a translation product of the human COQ8B gene or a 1:1 ortholog thereof.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADCK4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AarF domain-containing protein kinase 4</oboInOwl:hasExactSynonym>
