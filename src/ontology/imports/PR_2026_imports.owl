        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is a tyrosine kinase receptor that is activated by dimerization, resulting in autophosphorylation of intracellular tyrosine residues and triggering of the signal transduction cascade.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF000623</oboInOwl:hasDbXref>
