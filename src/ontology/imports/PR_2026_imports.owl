        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000682"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A voltage-gated potassium channel alpha subunit with PAS domain that is characterized by its nanomolar sensitivity to class III antiarrhythmic drugs.</obo:IAO_0000115>
