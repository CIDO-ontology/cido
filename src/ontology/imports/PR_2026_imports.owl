        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000001497"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An opioid receptor protein that is a translation product of the human OPRD1 gene or a 1:1 ortholog thereof. The preferred ligands are enkephalins.</obo:IAO_0000115>
