    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000024990">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type II interferon</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that binds to a specific cell surface receptor complex known as the IFN-gamma receptor (IFNGR), a complex of two IFNGR1 and two IFNGR2 chains.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family. Note: Some references consider &#39;gamma&#39; and &#39;type II&#39; to be synonyms. This is likely because gamma is the only type II interferon identified. However, the classification criteria for each nomenclature system differ.</rdfs:comment>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IFN type II</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000024990</oboInOwl:id>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interferon gamma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interferon type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025350 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025350">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HSPC protein</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000003425"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Hsp70 family chaperone that contains an ATPase and HSP90 domains.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HSP90</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025350</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025748 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025748">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janus kinase</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein with core domain composition consisting of an N-termianl FERM domain, followed by a copy of the SH2 domain (Pfam:PF00017), and two copies of the Protein tyrosine kinase (Pfam:PF07714) domain. Janus kinase is a non-receptor tyrosine kinase.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF000636</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025748</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025796 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025796">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrin alpha</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is composed of a long N-terminal extracellular domain, a transmembrane domain and a short cytoplasmic C-terminal domain. The N-terminal domain contains beta-propeller repeats (interrupted by an A domain in a subset of integrins alpha), while the C-terminal domain contains a GFFxR motif.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family. Integrins are heterodimeric complexes of an alpha and a beta subunit. They are a structurally elaborate family of adhesion molecules that transmit signals bidirectionally across the plasma membrane by undergoing large-scale structural rearrangements. By regulating cell-cell and cell-matrix contacts, integrins participate in a wide-range of biological interactions including development, tissue repair, angiogenesis, inflammation and hemostasis. [PMID:10402956, PMID:11988479, PMID:9676575].</rdfs:comment>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025796</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025845 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025845">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ephrin receptor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that consists of an Ephrin receptor ligand binding domain (Pfam:PF01404), two copies of the Fibronectin type III domain (Pfam:PF00041), and a copy of either type of SAM domain (Sterile alpha motif) (Pfam:PF00536 or Pfam:PF07647).</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025845</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025846 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025846">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fatty acid-binding protein</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that consists solely of the Lipocalin / cytosolic fatty-acid binding protein family domain (Pfam:PF00061).</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025846</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025848">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type I interferon</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that consists solely of an Interferon alpha/beta domain (Pfam:PF00143) and which binds to a specific cell surface receptor complex known as the IFN-alpha receptor (IFNAR), a heterodimer of IFNAR1 and IFNAR2 chains.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IFN type I</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025848</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interferon type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025875 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025875">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">serpin</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is primarily known as an irreversible serine protease inhibitor active against S1, S8 and C14 peptidases. There are both extra- and intra-cellular serpins, which are found in all groups of organisms with the notable exception of fungi. Serpin contains a copy of the Serpin (Pfam:PF00079) domain.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF001630</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000025875</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboInOwl:hasOBONamespace>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000027234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000027234">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proto-oncogene tyrosine-protein kinase Src</rdfs:label>
